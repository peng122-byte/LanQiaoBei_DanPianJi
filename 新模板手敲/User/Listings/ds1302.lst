  58          //写入11:12:13-> 0x11 0x12 0x13
  59          void Set_Rtc(unsigned char *ucRtc)
  60          {
  61   1        unsigned char i;
  62   1        Write_Ds1302_Byte(0x8e, 0x00);//关闭写保护
  63   1        Write_Ds1302_Byte(0x80, 0x80);//关闭CH, 停止计时
  64   1        for(i=0;i<3;i++)
  65   1        {
  66   2          Write_Ds1302_Byte(0x84-2*i,ucRtc[i]/10*16 + ucRtc[i]%10);//十进制转十六进制BCD码写入
  67   2        }
  68   1        Write_Ds1302_Byte(0x8e, 0x80);//开启写保护
  69   1      }
  70          
  71          //读取0x11 x12 0x13 ->11:12:13
  72          void Read_Rtc(unsigned char *ucRtc)
  73          {
  74   1        unsigned char i;
  75   1        unsigned char temp;
  76   1        EA = 0;
  77   1        for(i=0; i<3;i++)
  78   1        {
  79   2          temp = Read_Ds1302_Byte(0x85-2*i);
  80   2          ucRtc[i] = temp/16*10+temp%16;//十六进制BCD码转十进制
  81   2        }
  82   1        EA = 1;
  83   1      }


