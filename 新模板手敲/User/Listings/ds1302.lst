   7          sbit SCK = P1^7;
   8          sbit SDA = P2^3;
   9          sbit RST = P1^3;
  10          //
  11          void Write_Ds1302(unsigned  char temp) 
  12          {
  13   1        unsigned char i;
  14   1        for (i=0;i<8;i++)       
  15   1        { 
  16   2          SCK = 0;
  17   2          SDA = temp&0x01;
  18   2          temp>>=1; 
  19   2          SCK=1;
  20   2        }
  21   1      }   
  22          
  23          //
  24          void Write_Ds1302_Byte( unsigned char address,unsigned char dat )     
  25          {
  26   1        RST=0;  _nop_();
  27   1        SCK=0;  _nop_();
  28   1        RST=1;  _nop_();  
  29   1        Write_Ds1302(address);  
  30   1        Write_Ds1302(dat);    
  31   1        RST=0; 
  32   1      }
  33          
  34          //
  35          unsigned char Read_Ds1302_Byte ( unsigned char address )
  36          {
  37   1        unsigned char i,temp=0x00;
  38   1        RST=0;  _nop_();
  39   1        SCK=0;  _nop_();
  40   1        RST=1;  _nop_();
  41   1        Write_Ds1302(address);
  42   1        for (i=0;i<8;i++)   
  43   1        {   
  44   2          SCK=0;
  45   2          temp>>=1; 
  46   2          if(SDA)
  47   2          temp|=0x80; 
  48   2          SCK=1;
  49   2        } 
  50   1        RST=0;  _nop_();
  51   1        SCK=0;  _nop_();
  52   1        SCK=1;  _nop_();
  53   1        SDA=0;  _nop_();
