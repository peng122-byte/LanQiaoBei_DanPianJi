 268          typedef struct
 269          {
 270            void(*task_func)(void);
 271            unsigned long int rate_ms;
 272            unsigned long int last_ms;
 273          }task_t;
 274          idata task_t Scheduler_Task[]={
 275            {Led_Proc,1,0},
 276            {Key_Proc,10,0},
 277            {Seg_Proc,20,0},
 278            {Get_Time,100,0},
 279            {Get_Temperature,300,0},
