 211          
 212          void Timer0_Init(void)    //1毫秒@12.000MHz
 213          {
 214   1        AUXR &= 0x7F;     //定时器时钟12T模式
 215   1        TMOD &= 0xF0;     //设置定时器模式
 216   1        TMOD |= 0x05;     //设置定时器模式,计数器不重装载
 217   1        TL0 = 0x00;       //设置定时初始值
 218   1        TH0 = 0x00;       //设置定时初始值
 219   1        TF0 = 0;        //清除TF0标志
 220   1        TR0 = 1;        //定时器0开始计时
 221   1      
 222   1      }
