 284          idata unsigned char task_num;
 285          void Scheduler_Init()
 286          {
 287   1        task_num = sizeof(Scheduler_Task)/sizeof(task_t);
 288   1      }
 289          void Scheduler_Run()
 290          {
 291   1        unsigned char i;
 292   1        for(i=0;i<task_num;i++)
 293   1        {
 294   2          unsigned long int now_time = uwTick;
 295   2          if(now_time >= (Scheduler_Task[i].rate_ms+Scheduler_Task[i].last_ms))
 296   2          {
 297   3            Scheduler_Task[i].last_ms = now_time;
 298   3            Scheduler_Task[i].task_func();
 299   3          }
 300   2        }
 301   1      }
