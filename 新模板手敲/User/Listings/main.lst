 199          void Timer1_Init(void)
 200          {
 201   1        AUXR &= 0xBF;
 202   1        TMOD &= 0x0F;
 203   1        TL1 = 0x18;
 204   1        TH1 = 0xFC;
 205   1        TF1 = 0;
 206   1        TR1 = 1;
 207   1        ET1 = 1;
 208   1        EA = 1;
