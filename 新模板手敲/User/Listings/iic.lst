 161   1        I2CWaitAck();
 162   1        
 163   1        
 164   1        while(num--)
 165   1        {
 166   2          I2CSendByte(*str++);//写入我们的每一位数据后指针递增,然后为下一次写数据准备
 167   2          I2CWaitAck();
 168   2          I2C_Delay(200);//保证完全写入
 169   2        }
 170   1        I2CStop();
 171   1        I2C_Delay(255);
