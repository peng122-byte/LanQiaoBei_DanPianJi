 120          //0-5的模拟量转换为0-255
 121          unsigned char Ad_Read(unsigned char addr)
 122          {
 123   1        unsigned char temp;
 124   1        
 125   1        I2CStart();
 126   1        I2CSendByte(0x90);//选中PCF,并且写操作
 127   1        I2CWaitAck();
 128   1        I2CSendByte(addr);//写入想要转换的地址
 129   1        I2CWaitAck();
 130   1        
 131   1        I2CStart();
 132   1        I2CSendByte(0x91);//选中PCF，并且读操作
 133   1        I2CWaitAck();
 134   1        temp = I2CReceiveByte();
 135   1        
 136   1        I2CSendAck(1);
 137   1        I2CStop();
 138   1        
 139   1        return temp;
 140   1      }
 141          
 142          //0-255的数字量转换为0-5
 143          void Da_Write(unsigned char dat)
 144          {
 145   1        I2CStart();
 146   1        I2CSendByte(0x90);//选中PCF,并且写操作
 147   1        I2CWaitAck();
 148   1        I2CSendByte(0x41);//写入DA使能
 149   1        I2CWaitAck();
 150   1        I2CSendByte(dat);//写入数字电压，DA可以转换为模拟电压
 151   1        I2CWaitAck();
 152   1      }
