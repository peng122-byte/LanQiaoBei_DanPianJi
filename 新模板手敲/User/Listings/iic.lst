 119          //0-5的模拟量转换为0-255
 120          unsigned char Ad_Read(unsigned char addr)
 121          {
 122   1        unsigned char temp;
 123   1        
 124   1        I2CStart();
 125   1        I2CSendByte(0x90);//选中PCF,并且写操作
 126   1        I2CWaitAck();
 127   1        I2CSendByte(addr);//写入想要转换的地址
 128   1        I2CWaitAck();
 129   1        
 130   1        I2CStart();
 131   1        I2CSendByte(0x91);//选中PCF，并且读操作
 132   1        I2CWaitAck();
 133   1        temp = I2CReceiveByte();
 134   1        
 135   1        I2CSendAck(1);
 136   1        I2CStop();
 137   1        
 138   1        return temp;
 139   1      }
