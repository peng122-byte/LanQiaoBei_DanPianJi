 154          //写入的数组，写入的起始位置，写入数据的个数（字节数）
 155          void EEPROM_Write(unsigned char *str,unsigned char addr,unsigned num)
 156          {
 157   1        I2CStart();
 158   1        I2CSendByte(0xa0);//选中AT24C02,并且写操作
 159   1        I2CWaitAck();
