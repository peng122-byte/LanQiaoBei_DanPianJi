   1          /**
   2           * @file    Seg.c
   3           * @brief   数码管显示驱动模块
   4           * @details CT107D开发板8位共阳数码管，通过74HC138+74HC573锁存器控制
   5           *          位选：Y6C锁存器(P2高3位=110=0xC0)
   6           *          段选：Y7C锁存器(P2高3位=111=0xE0)
   7           *          动态扫描方式：在定时器中断中逐位刷新，每次只点亮1位
   8           */
   9          #include "Seg.h"
  10          
  11          /**
  12           * @brief  共阳数码管段码表
  13           * @note   索引0~9对应数字0~9，索引10=0xFF(灭)
  14           *         共阳极：低电平点亮对应段
  15           */
  16          pdata unsigned char Seg_Dula[] = {
  17            0xC0,  // 0
  18            0xF9,  // 1
  19            0xA4,  // 2
  20            0xB0,  // 3
  21            0x99,  // 4
  22            0x92,  // 5
  23            0x82,  // 6
  24            0xF8,  // 7
  25            0x80,  // 8
  26            0x90,  // 9
  27            0xFF,   // 10=灭(全段熄灭)
  28            0xC1,//11-U
  29            0x8c,//12-P
  30            0xC8,//13-n
  31            
  32            
  33          };
  34          
  35          /**
  36           * @brief   数码管单位显示函数(在定时器中断中调用)
  37           * @param   Wela   位选(0~7对应第1~8位数码管)
  38           * @param   Dula   段码索引(0~9为数字，10为灭)
  39           * @param   Point  小数点(1=显示小数点，0=不显示)
  40           * @note    调用顺序：消影 -> 位选 -> 段选，防止鬼影
  41           */
  42          void Seg_Disp(unsigned char Wela, unsigned char Dula, bit Point)
  43          {
  44   1        unsigned char temp;
  45   1      
  46   1        /* 消影：先将段选设为全灭，防止切换位选时产生鬼影 */
  47   1        P0 = 0xff;
  48   1      
  49   1        temp = P2 & 0x1f;
  50   1        temp = temp | 0xe0;     // 选通Y7C(段选锁存器)
  51   1        P2 = temp;
  52   1        temp = P2 & 0x1f;
  53   1        P2 = temp;
  54   1      
C51 COMPILER V9.59.0.0   SEG                                                               03/02/2026 20:17:58 PAGE 2   

  55   1        /* 位选：选中目标数码管位 */
  56   1        P0 = 0x01 << Wela;     // 左移Wela位，选中对应数码管
  57   1      
  58   1        temp = P2 & 0x1f;
  59   1        temp = temp | 0xc0;     // 选通Y6C(位选锁存器)
  60   1        P2 = temp;
  61   1        temp = P2 & 0x1f;
  62   1        P2 = temp;
  63   1      
  64   1        /* 段选：输出段码 */
  65   1        P0 = Seg_Dula[Dula];   // 查表获取段码
  66   1      
  67   1        if(Point) P0 &= 0x7f;  // 显示小数点：将最高位(dp段)清零(共阳低电平点亮)
  68   1      
  69   1        temp = P2 & 0x1f;
  70   1        temp = temp | 0xe0;     // 选通Y7C(段选锁存器)
  71   1        P2 = temp;
  72   1        temp = P2 & 0x1f;
  73   1        P2 = temp;
  74   1      }


