  55   1        scl = 0;                   // 钳住总线，准备发送数据
  56   1      }
  57          
  58          /**
  59           * @brief   I2C停止信号
  60           * @note    时序：SCL高电平期间，SDA由低变高
  61           */
  62          void I2CStop(void)
  63          {
  64   1        sda = 0;
  65   1        scl = 1;
  66   1        I2C_Delay(DELAY_TIME);
  67   1        sda = 1;                   // SDA上升沿 = 停止信号
  68   1        I2C_Delay(DELAY_TIME);
  69   1      }
  70          
  71          /**
  72           * @brief   I2C发送一个字节
  73           * @param   byt  要发送的字节(MSB优先)
  74           * @note    数据在SCL低电平时准备，SCL高电平时被从机采样
  75           */
  76          void I2CSendByte(unsigned char byt)
  77          {
  78   1        unsigned char i;
  79   1      
  80   1        for(i=0; i<8; i++){
  81   2          scl = 0;
  82   2          I2C_Delay(DELAY_TIME);
  83   2          if(byt & 0x80){        // 取最高位
  84   3            sda = 1;
  85   3          }
  86   2          else{
  87   3            sda = 0;
  88   3          }
  89   2          I2C_Delay(DELAY_TIME);
  90   2          scl = 1;               // SCL上升沿，从机采样数据
  91   2          byt <<= 1;             // 左移准备下一位
  92   2          I2C_Delay(DELAY_TIME);
  93   2        }
  94   1      
  95   1        scl = 0;                   // 释放时钟线
  96   1      }
  97          
  98          /**
  99           * @brief   I2C接收一个字节
 100           * @return  接收到的字节数据
 101           * @note    主机释放SDA，在SCL高电平期间读取从机数据(MSB优先)
 102           */
 103          unsigned char I2CReceiveByte(void)
 104          {
 105   1        unsigned char da;
 106   1        unsigned char i;
 107   1        for(i=0; i<8; i++){
 108   2          scl = 1;
 109   2          I2C_Delay(DELAY_TIME);
 110   2          da <<= 1;              // 左移腾出最低位
 111   2          if(sda)
 112   2            da |= 0x01;       // SDA为高则最低位置1
 113   2          scl = 0;
 114   2          I2C_Delay(DELAY_TIME);
 115   2        }
 116   1        return da;
