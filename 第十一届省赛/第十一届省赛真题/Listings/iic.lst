 186          /**
 187           * @brief   PCF8591 DA转换(数字量 -> 模拟量)
 188           * @param   dat  8位DA值(0~255，对应0~5V模拟输出)
 189           * @note    控制字0x41开启DA输出功能
 190           *          电压计算：V_out = dat / 255 * 5V
 191           *          例如：Da_Write(3*51) 输出约3V
 192           */
 193          void Da_Write(unsigned char dat)
 194          {
 195   1        I2CStart();
 196   1        I2CSendByte(0x90);         // 选中PCF8591，写操作
 197   1        I2CWaitAck();
 198   1        I2CSendByte(0x41);         // 控制字：开启DA输出
 199   1        I2CWaitAck();
 200   1        I2CSendByte(dat);          // 写入DA数值
 201   1        I2CWaitAck();
 202   1        I2CStop();
 203   1      }
