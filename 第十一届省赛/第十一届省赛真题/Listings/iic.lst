 119          /**
 120           * @brief   I2C等待应答
 121           * @return  0=收到ACK(应答), 1=收到NACK(非应答)
 122           */
 123          unsigned char I2CWaitAck(void)
 124          {
 125   1        unsigned char ackbit;
 126   1      
 127   1        scl = 1;
 128   1        I2C_Delay(DELAY_TIME);
 129   1        ackbit = sda;              // 读取从机应答位(低电平=ACK)
 130   1        scl = 0;
 131   1        I2C_Delay(DELAY_TIME);
 132   1      
 133   1        return ackbit;
 134   1      }
