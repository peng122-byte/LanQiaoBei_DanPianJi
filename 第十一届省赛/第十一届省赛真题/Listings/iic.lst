 136          /**
 137           * @brief   I2C发送应答/非应答
 138           * @param   ackbit  0=发送ACK(继续接收), 1=发送NACK(停止接收)
 139           */
 140          void I2CSendAck(unsigned char ackbit)
 141          {
 142   1        scl = 0;
 143   1        sda = ackbit;              // 设置应答位
 144   1        I2C_Delay(DELAY_TIME);
 145   1        scl = 1;                   // SCL高电平，从机读取应答
 146   1        I2C_Delay(DELAY_TIME);
 147   1        scl = 0;
 148   1        sda = 1;                   // 释放数据线
 149   1        I2C_Delay(DELAY_TIME);
 150   1      }
