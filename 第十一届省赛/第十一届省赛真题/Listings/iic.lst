 245          /**
 246           * @brief   AT24C02 EEPROM连续读取
 247           * @param   str   读取数据存放的数组指针
 248           * @param   addr  EEPROM起始地址(0~255)
 249           * @param   num   读取字节数
 250           * @note    读取流程：先写入起始地址(伪写操作)，再切换为读模式连续读取
 251           *          最后一个字节发送NACK结束读取，其余字节发送ACK继续
 252           *          读取期间关闭中断EA，防止I2C时序被打断
 253           */
 254          void EEPROM_Read(unsigned char *str, unsigned char addr, unsigned num)
 255          {
 256   1        I2CStart();
 257   1        I2CSendByte(0xa0);         // 选中AT24C02，写操作(设置读取起始地址)
 258   1        I2CWaitAck();
 259   1        I2CSendByte(addr);         // 写入起始地址
 260   1        I2CWaitAck();
 261   1      
 262   1        I2CStart();                // 重复起始条件
 263   1        I2CSendByte(0xa1);         // 选中AT24C02，读操作
 264   1        I2CWaitAck();
 265   1      
 266   1        EA = 0;                    // 关中断，保证读取完整性
 267   1        while(num--)
 268   1        {
 269   2          *str++ = I2CReceiveByte();
 270   2          if(num)
 271   2            I2CSendAck(0);     // 还有数据要读，发送ACK
 272   2          else
 273   2            I2CSendAck(1);     // 最后一个字节，发送NACK结束
 274   2        }
 275   1        I2CStop();
 276   1        EA = 1;                    // 恢复中断
 277   1      }


