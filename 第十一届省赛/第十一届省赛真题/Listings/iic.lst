   8           *          4. AT24C02 EEPROM读写(256字节容量，I2C地址0xA0)
   9           *
  10           *          PCF8591通道说明(CT107D开发板)：
  11           *            0x40/0x00: 外部输入
  12           *            0x41/0x01: 光敏电阻
  13           *            0x42/0x02: 差分输入
  14           *            0x43/0x03: 滑动变阻器
  15           *
  16           *          本驱动代码基于蓝桥杯官方提供的代码片段修改
  17           */
  18          #include "iic.h"
  19          #include "intrins.h"
  20          
  21          #define DELAY_TIME  5          // I2C时序延时参数
  22          
  23          /* I2C总线引脚定义 */
  24          sbit scl = P2^0;              // 时钟线
