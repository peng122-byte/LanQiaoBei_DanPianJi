 207          /**
 208           * @brief   AT24C02 EEPROM连续写入
 209           * @param   str   待写入的数据数组指针
 210           * @param   addr  EEPROM起始地址(0~255)
 211           * @param   num   写入字节数
 212           * @note    AT24C02 I2C地址：写=0xA0, 读=0xA1
 213           *          页写入模式(8字节/页)，跨页需注意地址对齐
 214           *          写入后需要较长延时等待EEPROM内部编程完成(约5~10ms)
 215           */
 216          void EEPROM_Write(unsigned char *str, unsigned char addr, unsigned num)
 217          {
 218   1        I2CStart();
 219   1        I2CSendByte(0xa0);         // 选中AT24C02，写操作
 220   1        I2CWaitAck();
 221   1        I2CSendByte(addr);         // 写入起始地址
 222   1        I2CWaitAck();
 223   1      
 224   1        while(num--)
 225   1        {
 226   2          I2CSendByte(*str++);   // 逐字节写入数据
 227   2          I2CWaitAck();
 228   2          I2C_Delay(200);        // 字节间延时，保证写入完成
 229   2        }
 230   1        I2CStop();
 231   1      
 232   1        /* 写入完成后的长延时，等待EEPROM内部编程 */
 233   1        I2C_Delay(255);
 234   1        I2C_Delay(255);
 235   1        I2C_Delay(255);
 236   1        I2C_Delay(255);
 237   1        I2C_Delay(255);
 238   1        I2C_Delay(255);
 239   1        I2C_Delay(255);
