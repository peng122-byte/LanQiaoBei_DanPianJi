 152          /* ==================== PCF8591 AD/DA转换 ==================== */
 153          
 154          /**
 155           * @brief   PCF8591 AD转换(模拟量 -> 数字量)
 156           * @param   addr  通道地址：
 157           *                0x41 = 光敏电阻(通道1)
 158           *                0x43 = 滑动变阻器(通道3)
 159           *                0x40 = 外部输入(通道0)
 160           *                0x42 = 差分输入(通道2)
 161           * @return  8位AD值(0~255，对应0~5V模拟量)
 162           * @note    PCF8591 I2C地址：写=0x90, 读=0x91
 163           *          返回的是上一次转换的结果(流水线方式)
 164           */
 165          unsigned char Ad_Read(unsigned char addr)
 166          {
 167   1        unsigned char temp;
 168   1      
 169   1        I2CStart();
 170   1        I2CSendByte(0x90);         // 选中PCF8591，写操作
 171   1        I2CWaitAck();
 172   1        I2CSendByte(addr);         // 写入通道控制字
 173   1        I2CWaitAck();
 174   1      
 175   1        I2CStart();                // 重复起始条件，切换为读操作
 176   1        I2CSendByte(0x91);         // 选中PCF8591，读操作
 177   1        I2CWaitAck();
 178   1        temp = I2CReceiveByte();   // 读取AD转换结果
C51 COMPILER V9.59.0.0   IIC                                                               03/02/2026 20:01:19 PAGE 4   

 179   1      
 180   1        I2CSendAck(1);             // 发送NACK，不再继续读取
 181   1        I2CStop();
 182   1      
 183   1        return temp;
 184   1      }
