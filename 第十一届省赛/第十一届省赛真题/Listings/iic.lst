  27          /* ==================== I2C底层时序 ==================== */
  28          
  29          /**
  30           * @brief   I2C延时函数
  31           * @param   n  延时循环次数
  32           */
  33          static void I2C_Delay(unsigned char n)
  34          {
  35   1        do
  36   1        {
  37   2          _nop_();_nop_();_nop_();_nop_();_nop_();
  38   2          _nop_();_nop_();_nop_();_nop_();_nop_();
  39   2          _nop_();_nop_();_nop_();_nop_();_nop_();
  40   2        }
  41   1        while(n--);
  42   1      }
  43          
  44          /**
  45           * @brief   I2C起始信号
  46           * @note    时序：SCL高电平期间，SDA由高变低
  47           */
  48          void I2CStart(void)
  49          {
  50   1        sda = 1;
  51   1        scl = 1;
  52   1        I2C_Delay(DELAY_TIME);
  53   1        sda = 0;                   // SDA下降沿 = 起始信号
  54   1        I2C_Delay(DELAY_TIME);
