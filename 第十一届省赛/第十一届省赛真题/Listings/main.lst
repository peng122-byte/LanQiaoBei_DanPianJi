 286           *          4. EEPROM读写测试  - 验证EEPROM功能
 287           *          7. Timer1_Init()  - 系统节拍(最后初始化，启动中断)
 288           *          8. 主循环运行调度器
 289           */
 290          void main()
 291          {
 292   1        System_Init();                     // 系统初始化(关闭所有外设)
 293   1        Scheduler_Init();                  // 调度器初始化
 294   1        Timer1_Init();                      // 初始化系统节拍(1ms中断，最后启动)
 295   1        EEPROM_Read(&Voltage_E2PROM,0,1);
 296   1        Voltage_Set = Voltage_E2PROM *10;
 297   1        Ad_Read(0x43);
 298   1        while(1)
C51 COMPILER V9.59.0.0   MAIN                                                              03/02/2026 20:17:57 PAGE 6   

 299   1        {
 300   2          Scheduler_Run();                // 持续运行任务调度器
 301   2        }
