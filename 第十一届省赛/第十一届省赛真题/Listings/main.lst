 192          /**
 193           * @brief   定时器1中断服务函数(1ms周期)，中断号3
 194           * @note    承担5项职责：
 195           *          1. 系统节拍uwTick递增(驱动任务调度器)
 196           *          2. 数码管动态扫描(8位轮流显示)
 197           */
 198          void Timer1_Isr(void) interrupt 3
 199          {
 200   1        uwTick++;                  // 系统节拍+1
 201   1      
 202   1        /* 数码管动态扫描：每次中断显示下一位 */
 203   1        Seg_Pos = (++Seg_Pos) % 8;
 204   1        if(Seg_Buf[Seg_Pos] > 20)                              // >20说明带小数点标记(数字+',')
 205   1        {
 206   2          Seg_Disp(Seg_Pos, Seg_Buf[Seg_Pos] - ',', 1);      // 减去','恢复段码索引，第3参数1=显示�
             -�数点
 207   2        }else
 208   1        {
 209   2          Seg_Disp(Seg_Pos, Seg_Buf[Seg_Pos], 0);            // 正常显示，无小数点
 210   2        }
 211   1        Led_Disp(ucLed);
 212   1        if(Flag == 0)
 213   1        {
 214   2          Time5000++;
 215   2        }
 216   1        
 217   1        }
