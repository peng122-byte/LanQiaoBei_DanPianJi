 224          /**
 225           * @brief   任务结构体定义
 226           * @details 每个任务包含：函数指针、执行周期(ms)、上次执行时间
 227           */
 228          typedef struct
 229          {
 230            void(*task_func)(void);          // 任务函数指针
 231            unsigned long int rate_ms;       // 执行周期(ms)
 232            unsigned long int last_ms;       // 上次执行时的uwTick值
 233          } task_t;
 234          
 235          /**
 236           * @brief   任务列表(静态配置)
C51 COMPILER V9.59.0.0   MAIN                                                              03/02/2026 20:17:57 PAGE 5   

 237           * @note    各任务按功能和频率需求分配周期：
 238           *          高频任务：LED(1ms)、按键/串口(10ms)、数码管(20ms)
 239           *          低频任务：AD/DA(150ms)
 240           */
 241          idata task_t Scheduler_Task[] = {
 242            {Led_Proc,        1,   0},       // LED状态更新(1ms)
 243            {Key_Proc,        10,  0},       // 按键扫描(10ms)
 244            {Seg_Proc,        20,  0},       // 数码管显示更新(20ms)
 245            {AD_DA,           150, 0},       // AD采集与DA输出(150ms)
 246          };
 247          
 248          idata unsigned char task_num;        // 任务总数
 249          
 250          /**
 251           * @brief   调度器初始化
 252           * @note    自动计算任务数量，无需手动维护
 253           */
 254          void Scheduler_Init()
 255          {
 256   1        task_num = sizeof(Scheduler_Task) / sizeof(task_t);
 257   1      }
 258          
 259          /**
 260           * @brief   调度器运行(在主循环中持续调用)
 261           * @note    遍历所有任务，检查是否到达执行周期：
 262           *          当前时间 - 上次执行时间 >= 任务周期 -> 执行任务
 263           *          非抢占式：任务执行期间不会被其他任务打断(中断除外)
 264           */
 265          void Scheduler_Run()
 266          {
 267   1        unsigned char i;
 268   1        for(i=0; i<task_num; i++)
 269   1        {
 270   2          unsigned long int now_time = uwTick;
 271   2          if(now_time >= (Scheduler_Task[i].rate_ms + Scheduler_Task[i].last_ms))
 272   2          {
 273   3            Scheduler_Task[i].last_ms = now_time;  // 记录本次执行时间
 274   3            Scheduler_Task[i].task_func();          // 调用任务函数
 275   3          }
 276   2        }
 277   1      }
