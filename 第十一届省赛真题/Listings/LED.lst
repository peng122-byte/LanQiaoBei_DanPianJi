   8          /**
   9           * @brief   LED显示函数
  10           * @param   ucLed  8字节数组指针，每个元素0=灭，1=亮，对应L1~L8
  11           * @note    仅当LED状态发生变化时才操作锁存器，提高效率
  12           */
  13          void Led_Disp(unsigned char *ucLed)
  14          {
  15   1        unsigned char temp;
  16   1      
  17   1        /* 将8个独立的0/1值合并为一个字节 */
  18   1        temp_1 = 0x00;
  19   1        temp_1 = (ucLed[0]<<0)|(ucLed[1]<<1)|(ucLed[2]<<2)|(ucLed[3]<<3)|
  20   1        (ucLed[4]<<4)|(ucLed[5]<<5)|(ucLed[6]<<6)|(ucLed[7]<<7);
  21   1      
  22   1        /* 仅当LED状态发生变化时才刷新 */
  23   1        if(temp_1 != temp_1_old)
  24   1        {
  25   2          P0 = ~temp_1;              // 取反：硬件低电平点亮LED
  26   2      
  27   2          temp = P2 & 0x1f;         // 保留P2低5位
  28   2          temp = temp | 0x80;       // 选通Y4C(LED锁存器)
  29   2          P2 = temp;
  30   2          temp = P2 & 0x1f;         // 关闭选通
  31   2          P2 = temp;
  32   2      
  33   2          temp_1_old = temp_1;      // 更新旧状态
  34   2        }
  35   1      }
