 235          {
 236            void(*task_func)(void);          // 任务函数指针
 237            unsigned long int rate_ms;       // 执行周期(ms)
 238            unsigned long int last_ms;       // 上次执行时的uwTick值
 239          } task_t;
 240          
 241          /**
 242           * @brief   任务列表(静态配置)
 243           * @note    各任务按功能和频率需求分配周期：
 244           *          高频任务：LED(1ms)、按键/串口(10ms)、数码管(20ms)
