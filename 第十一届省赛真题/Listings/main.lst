  46   1        Key_Up = ~Key_Val & (Key_Val ^ Key_Old);       // 检测释放沿(由有到无)
  47   1        Key_Old = Key_Val;                              // 保存当前值供下次比较
  48   1        switch(Key_Down)
  49   1        {
