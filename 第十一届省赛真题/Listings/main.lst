 246           */
 247          idata task_t Scheduler_Task[] = {
 248            {Led_Proc,        1,   0},       // LED状态更新(1ms)
 249            {Key_Proc,        10,  0},       // 按键扫描(10ms)
 250            {Seg_Proc,        20,  0},       // 数码管显示更新(20ms)
 251            {Get_Temperature, 1000, 0},      // 温度采集(1000ms，DS18B20 12位转换需750ms)
 252            {AD_DA,           150, 0},       // AD采集与DA输出(150ms)
 253          };
 254          
 255          idata unsigned char task_num;        // 任务总数
 256          
 257          /**
 258           * @brief   调度器初始化
 259           * @note    自动计算任务数量，无需手动维护
 260           */
 261          void Scheduler_Init()
 262          {
 263   1        task_num = sizeof(Scheduler_Task) / sizeof(task_t);
 264   1      }
 265          
 266          /**
 267           * @brief   调度器运行(在主循环中持续调用)
 268           * @note    遍历所有任务，检查是否到达执行周期：
 269           *          当前时间 - 上次执行时间 >= 任务周期 -> 执行任务
 270           *          非抢占式：任务执行期间不会被其他任务打断(中断除外)
 271           */
 272          void Scheduler_Run()
 273          {
 274   1        unsigned char i;
 275   1        for(i=0; i<task_num; i++)
 276   1        {
 277   2          unsigned long int now_time = uwTick;
 278   2          if(now_time >= (Scheduler_Task[i].rate_ms + Scheduler_Task[i].last_ms))
 279   2          {
 280   3            Scheduler_Task[i].last_ms = now_time;  // 记录本次执行时间
 281   3            Scheduler_Task[i].task_func();          // 调用任务函数
 282   3          }
 283   2        }
 284   1      }
