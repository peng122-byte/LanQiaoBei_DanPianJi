 199          /* ==================== 任务调度器 ==================== */
 200          
 201          /**
 202           * @brief   任务结构体定义
 203           * @details 每个任务包含：函数指针、执行周期(ms)、上次执行时间
 204           */
 205          typedef struct
 206          {
 207            void(*task_func)(void);          // 任务函数指针
 208            unsigned long int rate_ms;       // 执行周期(ms)
 209            unsigned long int last_ms;       // 上次执行时的uwTick值
 210          } task_t;
 211          
 212          /**
 213           * @brief   任务列表(静态配置)
 214           * @note    各任务按功能和频率需求分配周期：
 215           *          高频任务：LED(1ms)、按键/串口(10ms)、数码管(20ms)
 216           *          低频任务：AD/DA(150ms)、温度(300ms)
 217           */
 218          idata task_t Scheduler_Task[] = {
 219            {Led_Proc,        1,   0},       // LED状态更新(1ms)
 220            {Key_Proc,        10,  0},       // 按键扫描(10ms)
 221            {Seg_Proc,        20,  0},       // 数码管显示更新(20ms)
 222            {Get_Temperature, 300, 0},       // 温度采集(300ms)
 223            {AD_DA,           150, 0},       // AD采集与DA输出(150ms)
 224          };
 225          
 226          idata unsigned char task_num;        // 任务总数
 227          
 228          /**
 229           * @brief   调度器初始化
 230           * @note    自动计算任务数量，无需手动维护
 231           */
 232          void Scheduler_Init()
 233          {
 234   1        task_num = sizeof(Scheduler_Task) / sizeof(task_t);
 235   1      }
 236          
C51 COMPILER V9.59.0.0   MAIN                                                              03/01/2026 21:17:23 PAGE 5   

 237          /**
 238           * @brief   调度器运行(在主循环中持续调用)
 239           * @note    遍历所有任务，检查是否到达执行周期：
 240           *          当前时间 - 上次执行时间 >= 任务周期 -> 执行任务
 241           *          非抢占式：任务执行期间不会被其他任务打断(中断除外)
 242           */
 243          void Scheduler_Run()
 244          {
 245   1        unsigned char i;
 246   1        for(i=0; i<task_num; i++)
 247   1        {
 248   2          unsigned long int now_time = uwTick;
 249   2          if(now_time >= (Scheduler_Task[i].rate_ms + Scheduler_Task[i].last_ms))
 250   2          {
 251   3            Scheduler_Task[i].last_ms = now_time;  // 记录本次执行时间
 252   3            Scheduler_Task[i].task_func();          // 调用任务函数
 253   3          }
 254   2        }
 255   1      }
 256          
 257          /* ==================== 主函数 ==================== */
 258          
 259          /**
 260           * @brief   程序入口
 261           * @note    初始化顺序：
 262           *          1. System_Init()  - 关闭所有外设，防止误动作
 263           *          2. Scheduler_Init() - 初始化任务调度器
 264           *          7. Timer1_Init()  - 系统节拍(最后初始化，启动中断)
 265           *          8. 主循环运行调度器
 266           */
 267          void main()
 268          {
 269   1        System_Init();                     // 系统初始化(关闭所有外设)
 270   1        Scheduler_Init();                  // 调度器初始化
 271   1        Timer1_Init();                      // 初始化系统节拍(1ms中断，最后启动)
 272   1        while(1)
 273   1        {
 274   2          Scheduler_Run();                // 持续运行任务调度器
 275   2        }
 276   1      }


