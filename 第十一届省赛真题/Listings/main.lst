 147          /* ==================== 定时器初始化 ==================== */
 148          
 149          /**
 150           * @brief   定时器1初始化(1ms定时中断@12MHz)
 151           * @note    12T模式，16位自动重装
 152           *          初值：0xFC18 = 65536 - 1000 = 64536 (12MHz/12 = 1MHz, 1000us = 1ms)
 153           *          用途：系统节拍、数码管扫描、PWM、频率计数、串口超时
 154           */
 155          void Timer1_Init(void)
 156          {
 157   1        AUXR &= 0xBF;             // 定时器1时钟 = 系统时钟/12(12T模式)
 158   1        TMOD &= 0x0F;             // 清除定时器1模式位，使用模式0(16位自动重装)
 159   1        TL1 = 0x18;               // 定时初值低字节
 160   1        TH1 = 0xFC;               // 定时初值高字节
 161   1        TF1 = 0;                  // 清除溢出标志
 162   1        TR1 = 1;                  // 启动定时器1
 163   1        ET1 = 1;                  // 使能定时器1中断
 164   1        EA = 1;                   // 使能总中断
 165   1      }
 166          
 167          
 168          
 169          /* ==================== 中断服务函数 ==================== */
 170          
 171          /**
 172           * @brief   定时器1中断服务函数(1ms周期)，中断号3
 173           * @note    承担5项职责：
 174           *          1. 系统节拍uwTick递增(驱动任务调度器)
 175           *          2. 数码管动态扫描(8位轮流显示)
C51 COMPILER V9.59.0.0   MAIN                                                              03/01/2026 21:17:23 PAGE 4   

 176           *          3. 频率计数(每1000次=1秒读取Timer0计数值)
 177           *          4. LED的PWM调光(10级占空比)
 178           *          5. 串口接收超时计数
 179           */
 180          void Timer1_Isr(void) interrupt 3
 181          {
 182   1        uwTick++;                  // 系统节拍+1
 183   1      
 184   1        /* 数码管动态扫描：每次中断显示下一位 */
 185   1        Seg_Pos = (++Seg_Pos) % 8;
 186   1        if(Seg_Buf[Seg_Pos] > 20)                              // >20说明带小数点标记(数字+',')
 187   1        {
 188   2          Seg_Disp(Seg_Pos, Seg_Buf[Seg_Pos] - ',', 1);      // 减去','恢复段码索引，第3参数1=显示�
             -�数点
 189   2        }else
 190   1        {
 191   2          Seg_Disp(Seg_Pos, Seg_Buf[Seg_Pos], 0);            // 正常显示，无小数点
 192   2        }
 193   1      
 194   1      
 195   1      }
