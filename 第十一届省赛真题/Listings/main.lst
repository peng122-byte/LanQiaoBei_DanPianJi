 245           */
 246          idata task_t Scheduler_Task[] = {
 247            {Led_Proc,        1,   0},       // LED状态更新(1ms)
 248            {Key_Proc,        10,  0},       // 按键扫描(10ms)
 249            {Seg_Proc,        20,  0},       // 数码管显示更新(20ms)
 250            {Get_Temperature, 300, 0},       // 温度采集(300ms)
 251            {AD_DA,           150, 0},       // AD采集与DA输出(150ms)
 252          };
 253          
 254          idata unsigned char task_num;        // 任务总数
 255          
 256          /**
 257           * @brief   调度器初始化
 258           * @note    自动计算任务数量，无需手动维护
 259           */
 260          void Scheduler_Init()
 261          {
 262   1        task_num = sizeof(Scheduler_Task) / sizeof(task_t);
 263   1      }
 264          
 265          /**
 266           * @brief   调度器运行(在主循环中持续调用)
 267           * @note    遍历所有任务，检查是否到达执行周期：
 268           *          当前时间 - 上次执行时间 >= 任务周期 -> 执行任务
 269           *          非抢占式：任务执行期间不会被其他任务打断(中断除外)
 270           */
 271          void Scheduler_Run()
 272          {
 273   1        unsigned char i;
 274   1        for(i=0; i<task_num; i++)
 275   1        {
 276   2          unsigned long int now_time = uwTick;
 277   2          if(now_time >= (Scheduler_Task[i].rate_ms + Scheduler_Task[i].last_ms))
 278   2          {
 279   3            Scheduler_Task[i].last_ms = now_time;  // 记录本次执行时间
 280   3            Scheduler_Task[i].task_func();          // 调用任务函数
 281   3          }
 282   2        }
 283   1      }
