 176          /* ==================== 定时器初始化 ==================== */
 177          
 178          /**
 179           * @brief   定时器1初始化(1ms定时中断@12MHz)
 180           * @note    12T模式，16位自动重装
 181           *          初值：0xFC18 = 65536 - 1000 = 64536 (12MHz/12 = 1MHz, 1000us = 1ms)
 182           *          用途：系统节拍、数码管扫描、PWM、频率计数、串口超时
 183           */
 184          void Timer1_Init(void)
 185          {
 186   1        AUXR &= 0xBF;             // 定时器1时钟 = 系统时钟/12(12T模式)
 187   1        TMOD &= 0x0F;             // 清除定时器1模式位，使用模式0(16位自动重装)
 188   1        TL1 = 0x18;               // 定时初值低字节
 189   1        TH1 = 0xFC;               // 定时初值高字节
 190   1        TF1 = 0;                  // 清除溢出标志
 191   1        TR1 = 1;                  // 启动定时器1
 192   1        ET1 = 1;                  // 使能定时器1中断
 193   1        EA = 1;                   // 使能总中断
 194   1      }
 195          
 196          
 197          
 198          /* ==================== 中断服务函数 ==================== */
 199          
 200          /**
 201           * @brief   定时器1中断服务函数(1ms周期)，中断号3
 202           * @note    承担5项职责：
 203           *          1. 系统节拍uwTick递增(驱动任务调度器)
 204           *          2. 数码管动态扫描(8位轮流显示)
 205           *          3. 频率计数(每1000次=1秒读取Timer0计数值)
 206           *          4. LED的PWM调光(10级占空比)
 207           *          5. 串口接收超时计数
 208           */
 209          void Timer1_Isr(void) interrupt 3
 210          {
 211   1        uwTick++;                  // 系统节拍+1
 212   1      
 213   1        /* 数码管动态扫描：每次中断显示下一位 */
 214   1        Seg_Pos = (++Seg_Pos) % 8;
 215   1        if(Seg_Buf[Seg_Pos] > 20)                              // >20说明带小数点标记(数字+',')
 216   1        {
 217   2          Seg_Disp(Seg_Pos, Seg_Buf[Seg_Pos] - ',', 1);      // 减去','恢复段码索引，第3参数1=显示�
             -�数点
 218   2        }else
 219   1        {
 220   2          Seg_Disp(Seg_Pos, Seg_Buf[Seg_Pos], 0);            // 正常显示，无小数点
 221   2        }
 222   1        Led_Disp(ucLed);
 223   1      
 224   1      }
