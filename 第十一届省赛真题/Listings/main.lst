 235            void(*task_func)(void);          // 任务函数指针
 236            unsigned long int rate_ms;       // 执行周期(ms)
 237            unsigned long int last_ms;       // 上次执行时的uwTick值
 238          } task_t;
 239          
 240          /**
 241           * @brief   任务列表(静态配置)
 242           * @note    各任务按功能和频率需求分配周期：
 243           *          高频任务：LED(1ms)、按键/串口(10ms)、数码管(20ms)
