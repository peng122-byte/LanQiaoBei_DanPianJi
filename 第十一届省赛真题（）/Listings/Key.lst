   1          /**
   2           * @file    Key.c
   3           * @brief   矩阵键盘驱动模块
   4           * @details CT107D开发板4x4矩阵键盘扫描
   5           *          行线：P44, P42, P35, P34(P34与频率计数复用)
   6           *          列线：P30, P31, P32, P33
   7           *          扫描方式：逐行拉低，检测列线状态
   8           *
   9           *          键值映射(行x列)：
  10           *          P44行: S7=7  S6=6  S5=5  S4=4
  11           *          P42行: S11=11 S10=10 S9=9 S8=8
  12           *          P35行: S15=15 S14=14 S13=13 S12=12
  13           *          P34行: S19=19 S18=18 S17=17 S16=16 (频率计数时不可用)
  14           *
  15           *          特殊：S9+S8同时按下返回89(组合键示例)
  16           */
  17          #include "Key.h"
  18          
  19          /**
  20           * @brief   读取当前按下的键值
  21           * @return  按键编号(4~19)，无按键按下返回0
  22           *          特殊返回值89表示S9+S8同时按下
  23           * @note    - 如果需要频率计数功能，P34行需注释掉(与Timer0计数器输入复用)
  24           *          - 扫描前后恢复P3口状态，避免影响频率测量(P3为双向口)
  25           */
  26          unsigned char Key_Read()
  27          {
  28   1        unsigned char temp = 0;
  29   1      
  30   1        /* ---- 矩阵键盘扫描 ---- */
  31   1        /* 注意：如果需要测量频率，必须注释P34行扫描 */
  32   1      
  33   1        /* 防抖预检测：所有行拉高，若P30仍为低说明存在干扰，直接返回0 */
  34   1        P44 = 1; P42 = 1; P35 = 1; P34 = 1;
  35   1        if(P30 == 0) return 0;
  36   1      
  37   1        /* 第1行扫描：P44拉低 */
  38   1        P44 = 0; P42 = 1; P35 = 1; P34 = 1;
  39   1        if(P30 == 0) temp = 7;     // S7
  40   1        if(P31 == 0) temp = 6;     // S6
  41   1        if(P32 == 0) temp = 5;     // S5
  42   1        if(P33 == 0) temp = 4;     // S4
  43   1      
  44   1        /* 防抖隔离：恢复行线后检测列线 */
  45   1        P44 = 1; P42 = 1; P35 = 1; P34 = 1;
  46   1        if(P30 == 0) return 0;
  47   1      
  48   1        /* 第2行扫描：P42拉低 */
  49   1        P44 = 1; P42 = 0; P35 = 1; P34 = 1;
  50   1        if(P30 == 0) temp = 11;    // S11
  51   1        if(P31 == 0) temp = 10;    // S10
  52   1        if(P32 == 0) temp = 9;     // S9
  53   1        if(P33 == 0) temp = 8;     // S8
  54   1      
C51 COMPILER V9.59.0.0   KEY                                                               03/02/2026 19:22:39 PAGE 2   

  55   1        P44 = 1; P42 = 1; P35 = 1; P34 = 1;
  56   1        if(P30 == 0) return 0;
  57   1      
  58   1        /* 第3行扫描：P35拉低 */
  59   1        P44 = 1; P42 = 1; P35 = 0; P34 = 1;
  60   1        if(P30 == 0) temp = 15;     //S15
  61   1        if(P31 == 0) temp = 14;    // S14
  62   1        if(P32 == 0) temp = 13;    // S13
  63   1        if(P33 == 0) temp = 12;    // S12
  64   1      
  65   1        /* 第4行扫描(频率计数时注释此段)：P34拉低 */
  66   1        
  67   1      
  68   1        P44 = 1; P42 = 1; P35 = 1; P34 = 0;
  69   1        if(P30 == 0) temp = 19;    // S19
  70   1        if(P31 == 0) temp = 18;    // S18
  71   1        if(P32 == 0) temp = 17;    // S17
  72   1        if(P33 == 0) temp = 16;    // S16
  73   1        
  74   1      
  75   1        /* 恢复所有行线为高电平 */
  76   1        P44 = 1; P42 = 1; P35 = 1; P34 = 1;
  77   1        P3 = P3 | 0xff;  // 0xEF=1110_1111，恢复P3口但不影响P34(频率采集引脚，P3为双向口)
  78   1      
  79   1        return temp;
  80   1      }


