C51 COMPILER V9.59.0.0   MAIN                                                              03/02/2026 19:22:38 PAGE 5   

 237          };
 238          
 239          idata unsigned char task_num;        // 任务总数
 240          
 241          /**
 242           * @brief   调度器初始化
 243           * @note    自动计算任务数量，无需手动维护
 244           */
 245          void Scheduler_Init()
 246          {
 247   1        task_num = sizeof(Scheduler_Task) / sizeof(task_t);
 248   1      }
 249          
 250          /**
 251           * @brief   调度器运行(在主循环中持续调用)
 252           * @note    遍历所有任务，检查是否到达执行周期：
 253           *          当前时间 - 上次执行时间 >= 任务周期 -> 执行任务
 254           *          非抢占式：任务执行期间不会被其他任务打断(中断除外)
 255           */
 256          void Scheduler_Run()
 257          {
 258   1        unsigned char i;
 259   1        for(i=0; i<task_num; i++)
 260   1        {
 261   2          unsigned long int now_time = uwTick;
 262   2          if(now_time >= (Scheduler_Task[i].rate_ms + Scheduler_Task[i].last_ms))
 263   2          {
 264   3            Scheduler_Task[i].last_ms = now_time;  // 记录本次执行时间
 265   3            Scheduler_Task[i].task_func();          // 调用任务函数
 266   3          }
 267   2        }
 268   1      }
