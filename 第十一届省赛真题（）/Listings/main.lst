 162          /**
 163           * @brief   定时器1初始化(1ms定时中断@12MHz)
 164           * @note    12T模式，16位自动重装
 165           *          初值：0xFC18 = 65536 - 1000 = 64536 (12MHz/12 = 1MHz, 1000us = 1ms)
 166           *          用途：系统节拍、数码管扫描、PWM、频率计数、串口超时
 167           */
 168          void Timer1_Init(void)
 169          {
 170   1        AUXR &= 0xBF;             // 定时器1时钟 = 系统时钟/12(12T模式)
 171   1        TMOD &= 0x0F;             // 清除定时器1模式位，使用模式0(16位自动重装)
 172   1        TL1 = 0x18;               // 定时初值低字节
 173   1        TH1 = 0xFC;               // 定时初值高字节
 174   1        TF1 = 0;                  // 清除溢出标志
 175   1        TR1 = 1;                  // 启动定时器1
C51 COMPILER V9.59.0.0   MAIN                                                              03/02/2026 19:22:38 PAGE 4   

 176   1        ET1 = 1;                  // 使能定时器1中断
 177   1        EA = 1;                   // 使能总中断
 178   1      }
