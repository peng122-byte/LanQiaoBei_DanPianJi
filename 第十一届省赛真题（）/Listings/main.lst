 270          /* ==================== 主函数 ==================== */
 271          
 272          /**
 273           * @brief   程序入口
 274           * @note    初始化顺序：
 275           *          1. System_Init()  - 关闭所有外设，防止误动作
 276           *          2. Scheduler_Init() - 初始化任务调度器
 277           *          4. EEPROM读写测试  - 验证EEPROM功能
 278           *          7. Timer1_Init()  - 系统节拍(最后初始化，启动中断)
 279           *          8. 主循环运行调度器
 280           */
 281          void main()
 282          {
 283   1        System_Init();                     // 系统初始化(关闭所有外设)
 284   1        Scheduler_Init();                  // 调度器初始化
 285   1        Timer1_Init();                      // 初始化系统节拍(1ms中断，最后启动)
 286   1        EEPROM_Read(&Voltage_E2PROM,0,1);
 287   1        Voltage_Set = Voltage_E2PROM *10;
 288   1        Ad_Read(0x43);
 289   1        while(1)
 290   1        {
 291   2          Scheduler_Run();                // 持续运行任务调度器
 292   2        }
 293   1      }


