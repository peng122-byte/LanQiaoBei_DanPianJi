  47   1        Key_Down = Key_Val & (Key_Val ^ Key_Old);      // 检测按下沿(由无到有)
  48   1        Key_Up = ~Key_Val & (Key_Val ^ Key_Old);       // 检测释放沿(由有到无)
  49   1        Key_Old = Key_Val;                              // 保存当前值供下次比较
  50   1        switch(Key_Down)
  51   1        {
