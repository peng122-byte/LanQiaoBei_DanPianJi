 188           */
 189          void Timer1_Isr(void) interrupt 3
 190          {
 191   1        uwTick++;                  // 系统节拍+1
 192   1      
 193   1        /* 数码管动态扫描：每次中断显示下一位 */
 194   1        Seg_Pos = (++Seg_Pos) % 8;
 195   1        if(Seg_Buf[Seg_Pos] > 20)                              // >20说明带小数点标记(数字+',')
 196   1        {
 197   2          Seg_Disp(Seg_Pos, Seg_Buf[Seg_Pos] - ',', 1);      // 减去','恢复段码索引，第3参数1=显示�
             -�数点
 198   2        }else
 199   1        {
 200   2          Seg_Disp(Seg_Pos, Seg_Buf[Seg_Pos], 0);            // 正常显示，无小数点
 201   2        }
 202   1        Led_Disp(ucLed);
 203   1        if(Flag == 0)
 204   1        {
 205   2          Time5000++;
 206   2        }
 207   1        
 208   1        }
